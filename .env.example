# Von Render.com automatisch bereitgestellt, wenn du eine Postgres-DB verknüpfst.
# Lokal: eigene Verbindung eintragen, z.B. postgres://user:pass@localhost:5432/gutscheine
DATABASE_URL=

# Session-Secret: beliebige lange Zufallszeichenkette
SESSION_SECRET=bitte-aendern-zu-einem-langen-zufaelligen-string

PORT=3000
NODE_ENV=production

# Wird beim ersten Start (falls noch keine User existieren) als Admin angelegt.
INITIAL_ADMIN_EMAIL=admin@zillertal-sports.com
INITIAL_ADMIN_PASSWORD=bitte-vor-erstem-login-aendern
