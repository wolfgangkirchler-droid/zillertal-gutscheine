<%- include('partials/header', { title: 'Neuer Gutschein', active: 'new' }) %>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" style="max-width: 640px;">
  <form method="POST" action="/vouchers" id="voucher-form">
    <div class="form-group">
      <label for="voucher_type_id">Gutscheinart</label>
      <select id="voucher_type_id" name="voucher_type_id" required>
        <option value="">Bitte wählen…</option>
        <% voucherTypes.forEach(vt => { %>
          <option
            value="<%= vt.id %>"
            data-category="<%= vt.category %>"
            data-price="<%= vt.default_price || '' %>"
            data-leistung="<%= vt.default_leistung || '' %>"
            <%= (formData.voucher_type_id == vt.id) ? 'selected' : '' %>
          ><%= vt.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="wert">Wert <span class="hint">(€, individuell anpassbar)</span></label>
        <input type="number" step="0.01" min="0" id="wert" name="wert" value="<%= formData.wert || '' %>">
      </div>
      <div class="form-group">
        <label for="gueltig_bis">Gültig bis <span class="hint">(optional)</span></label>
        <input type="date" id="gueltig_bis" name="gueltig_bis" value="<%= formData.gueltig_bis || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label for="leistung_text">Leistungsbeschreibung <span class="hint">(individuell anpassbar, erscheint auf dem Gutschein)</span></label>
      <textarea id="leistung_text" name="leistung_text"><%= formData.leistung_text || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="empfaenger_name">Empfänger / Name auf dem Gutschein</label>
      <input type="text" id="empfaenger_name" name="empfaenger_name" value="<%= formData.empfaenger_name || '' %>" placeholder="z.B. Familie Mayer">
    </div>

    <div class="form-group">
      <label for="personal_message">Persönliche Nachricht <span class="hint">(optional)</span></label>
      <textarea id="personal_message" name="personal_message" placeholder="z.B. Alles Gute zum Geburtstag!"><%= formData.personal_message || '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Gutschein erstellen</button>
    <a href="/" class="btn btn-secondary">Abbrechen</a>
  </form>
</div>

<script>
  // Beim Wechsel der Gutscheinart Vorschlagswerte (Preis/Leistungstext) übernehmen,
  // solange das Feld vom Nutzer noch nicht manuell verändert wurde.
  const select = document.getElementById('voucher_type_id');
  const wertField = document.getElementById('wert');
  const leistungField = document.getElementById('leistung_text');
  let wertTouched = false, leistungTouched = false;
  wertField.addEventListener('input', () => wertTouched = true);
  leistungField.addEventListener('input', () => leistungTouched = true);

  select.addEventListener('change', () => {
    const opt = select.options[select.selectedIndex];
    if (!wertTouched) wertField.value = opt.dataset.price || '';
    if (!leistungTouched) leistungField.value = opt.dataset.leistung || '';
  });
</script>

<%- include('partials/footer') %>
